{
    "compilerOptions": {
        "lib": ["DOM", "ES2022"],
        "target": "ES2022",
        "module": "ESNext",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "useDefineForClassFields": true,
        "rootDir": "src"
    },
    "include": ["src"]
}
