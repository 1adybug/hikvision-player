{
    "name": "hikvision-player",
    "version": "0.0.4",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./assets/hikvision/*": "./dist/assets/hikvision/*"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rslib",
        "dev": "rslib --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "fg": "npm run format && git add . && git commit -m \"✨feature: format\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "@1adybug/eslint": "^0.0.10",
        "@1adybug/prettier": "^0.0.27",
        "@rsbuild/plugin-babel": "^1.1.2",
        "@rsbuild/plugin-react": "^2.0.0",
        "@rslib/core": "^0.21.5",
        "@types/react": "^19.2.14",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "react": ">=19.2.6",
        "react-dom": ">=19.2.6"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "deepsea-tools": "^5.48.0"
    }
}
